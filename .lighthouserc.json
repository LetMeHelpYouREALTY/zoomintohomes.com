{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/how-it-works",
        "http://127.0.0.1:3000/accessibility-features",
        "http://127.0.0.1:3000/veterans",
        "http://127.0.0.1:3000/aging-in-place",
        "http://127.0.0.1:3000/referral-partners",
        "http://127.0.0.1:3000/about",
        "http://127.0.0.1:3000/contact",
        "http://127.0.0.1:3000/accessibility-statement"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["accessibility"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
