# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Next.js Environment
NODE_ENV=development

# Site Configuration (canonical host — apex redirects to www)
NEXT_PUBLIC_SITE_URL=https://www.zoomintohomes.com

# Public contact (email optional; phone is published from content/site.ts)
NEXT_PUBLIC_AGENT_EMAIL=
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/drjanduffy/showing
NEXT_PUBLIC_SAMPLE_WALKTHROUGH_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_REALSCOUT_AGENT_ID=QWdlbnQtMjI1MDUw
NEXT_PUBLIC_REALSCOUT_PORTAL_URL=https://drjanduffy.realscout.com/

# Google Search Console HTML-tag verification (optional until GSC issues a token)
# Paste only the content= value, not the full meta tag.
# See docs/google-search-console.md
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Follow Up Boss (lead capture + webhooks)
# Prefer FUB_* names. FOLLOW_UP_BOSS_* aliases are also accepted.
# ---------------------------------------------------------------------------
FUB_API_KEY=
FUB_SYSTEM_KEY=
FOLLOW_UP_BOSS_API_KEY=
FOLLOW_UP_BOSS_SYSTEM_KEY=
FOLLOW_UP_BOSS_BASE_URL=https://api.followupboss.com/v1
FUB_BASE_URL=

# ---------------------------------------------------------------------------
# Optional integrations (set in Vercel if used; not all are wired in-app yet)
# ---------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_OPEN_HOUSES_MAP_EMBED_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
NOTION_TOKEN=
SMS_AUTO_REPLY_ENABLED=false
SMS_AUTO_REPLY_MESSAGE=
V0_API_KEY=
